# Local dev fallback when CF Access isn't fronting the app.
# In prod, this is unset and the Cf-Access-Authenticated-User-Email header is
# the source of truth.
DEV_USER_EMAIL=corey@experialstudio.com

# Anthropic API key (REQUIRED for the chef agent loop to actually think).
# Without it the agent emits a canned "wiring works but no key" reply.
# In prod: set via `wrangler pages secret put ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=

# Worker URL — defaults to the deployed mise-graph in lib/mcp.ts. Override
# only if you're running the worker locally on a different URL.
# NEXT_PUBLIC_WORKER_URL=http://localhost:8787
