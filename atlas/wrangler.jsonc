{
	"compatibility_date": "2026-05-13",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"name": "spence-atlas",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "atlas.cookspence.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
